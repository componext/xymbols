{
  "name": "xymbols-vue",
  "version": "0.0.0",
  "license": "ISC",
  "homepage": "https://github.com/componext/xymbols#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/componext/xymbols.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/componext/xymbols/issues"
  },
  "type": "module",
  "sideEffects": false,
  "description": "xymbols as Vue 3 components, a drop-in for @lucide/vue: every Lucide icon in nine weights, plus tagsets glyphs for licenses, locales, POS tags, tech abbreviations, keys and math.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dynamic": {
      "types": "./dist/dynamic.d.ts",
      "default": "./dist/dynamic.js"
    },
    "./icons/*": {
      "types": "./dist/generated/icons/*.d.ts",
      "default": "./dist/generated/icons/*.js"
    },
    "./glyphs/*": {
      "types": "./dist/generated/glyphs/*.d.ts",
      "default": "./dist/generated/glyphs/*.js"
    }
  },
  "files": [
    "dist",
    "LICENSE-lucide"
  ],
  "keywords": [
    "icons",
    "symbols",
    "svg",
    "lucide",
    "weights",
    "spdx",
    "bcp47",
    "keyboard",
    "math",
    "vue"
  ],
  "peerDependencies": {
    "vue": ">=3.3"
  },
  "devDependencies": {
    "vue": "^3.5.44"
  }
}
