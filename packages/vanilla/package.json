{
  "name": "xymbols",
  "version": "0.0.0",
  "license": "ISC",
  "homepage": "https://github.com/componext/xymbols#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/componext/xymbols.git",
    "directory": "packages/vanilla"
  },
  "bugs": {
    "url": "https://github.com/componext/xymbols/issues"
  },
  "type": "module",
  "sideEffects": false,
  "description": "xymbols without a framework: every Lucide icon and every tagsets glyph (licenses, locales, POS tags, tech, keys, math) as data, a drop-in for the lucide package (createIcons, createElement), SVG strings in nine weights, optimized SVGs, sprites, tiles and a manifest.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./icons/*": {
      "types": "./dist/generated/icons/*.d.ts",
      "default": "./dist/generated/icons/*.js"
    },
    "./animated": {
      "types": "./dist/animated.d.ts",
      "default": "./dist/animated.js"
    },
    "./animated/*": {
      "types": "./dist/generated/animated/*.d.ts",
      "default": "./dist/generated/animated/*.js"
    },
    "./animate.css": "./dist/animate.css",
    "./manifest.json": "./dist/manifest.json",
    "./sprite.svg": "./dist/sprite.svg",
    "./sprite-hug.svg": "./dist/sprite-hug.svg",
    "./svg/*": "./dist/svg/*",
    "./tiles/*": "./dist/tiles/*"
  },
  "files": [
    "dist",
    "LICENSE-lucide",
    "LICENSE-lucide-animated",
    "LICENSE-una"
  ],
  "keywords": [
    "icons",
    "symbols",
    "svg",
    "lucide",
    "weights",
    "spdx",
    "bcp47",
    "keyboard",
    "math",
    "sprite"
  ]
}
