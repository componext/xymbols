{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "types": [
      "node"
    ],
    "rootDirs": [
      "scripts/runtime",
      "scripts/runtime-web"
    ]
  },
  "include": [
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ]
}
